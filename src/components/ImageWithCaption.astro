---
// ImageWithCaption.astro
interface Props {
  src: string;
  alt: string;
  caption?: string;
  source?: string; // URL of the source (optional)
  float?: "left" | "right" | "none";
}

const { src, alt, caption, source, float = "none" } = Astro.props;
---

<figure
  class={`image-with-caption image-${float} ${source ? "has-source" : ""}`}
>
  <div class="image-wrapper">
    <img src={src} alt={alt} />

    {
      source && (
        <a
          class="source-badge"
          href={source}
          target="_blank"
          rel="noopener noreferrer"
          title="Ouvrir la source dans un nouvel onglet"
          aria-label="Source (ouvre dans un nouvel onglet)"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M14 3h7v7"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M10 14L21 3"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M21 21H3V3"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      )
    }
  </div>

  <div class="image-meta">
    {caption && <figcaption>{caption}</figcaption>}
  </div>
</figure>

<style>
  .image-with-caption {
    margin: 1rem 0;
  }

  /* Default stacked layout */
  .image-with-caption {
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
  }

  .image-wrapper img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    object-fit: cover;
  }

  /* Source badge: small icon overlay */
  .source-badge {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border-radius: 999px;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(4px);
  }

  /* Remove any global 'external link' decoration added by site styles */
  .source-badge::after {
    content: none !important;
  }

  .source-badge svg {
    display: block;
    width: 16px;
    height: 16px;
    stroke: currentColor;
  }

  .source-badge:hover {
    transform: translateY(-3px) scale(1.05);
    background: rgba(0, 0, 0, 0.75);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
  }

  /* Compact images when a source exists: reduce max width for float mode */
  .image-left {
    float: left;
    width: 45%;
    margin: 0.5rem 1.5rem 1rem 0;
  }

  .image-right {
    float: right;
    width: 45%;
    margin: 0.5rem 0 1rem 1.5rem;
  }

  .has-source.image-right img {
    float: right;
    margin-left: 1rem;
    margin-bottom: 0.75rem;
    max-width: 38%;
  }

  .has-source.image-left img {
    float: left;
    margin-right: 1rem;
    margin-bottom: 0.75rem;
    max-width: 38%;
  }

  /* Fallback float sizes when no source provided */
  .image-right {
    display: contents;
  }
  .image-right img {
    float: right;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
    max-width: 45%;
  }
  .image-left {
    display: contents;
  }
  .image-left img {
    float: left;
    margin-right: 1.5rem;
    margin-bottom: 1rem;
    max-width: 45%;
  }

  .image-meta {
    width: 100%;
  }

  /* Force caption color (override theme) */
  .image-with-caption figcaption {
    color: #666;
    font-size: 0.85rem;
    line-height: 1.4;
    margin: 0;

    padding-left: 0.75rem;
    border-left: 2px solid #666;
    text-align: left;
    font-style: italic;
  }

  @media (max-width: 720px) {
    .has-source.image-right img,
    .has-source.image-left img,
    .image-left,
    .image-right {
      float: none;
      width: 100%;
      margin: 1.5rem 0;
    }

    .source-badge {
      right: 6px;
      bottom: 6px;
      transform: scale(0.9);
    }
  }
</style>
