---
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(
    (entry) => !entry.data.draft,
  );

  return projects.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ProjectLayout
  title={entry.data.title}
  description={entry.data.description ?? entry.data.excerpt}
  role={entry.data.role}
  type={entry.data.type}
  lastUpdate={entry.data.last_update}
  thumbnail={entry.data.thumbnail}
  tags={entry.data.tags}
  languages={entry.data.languages}
  github={entry.data.github ?? entry.data.github_repo}
  gitlab={entry.data.gitlab}
  steam={entry.data.steam}
  company={entry.data.company}
  jamName={entry.data.jam_name}
>
  <Content />
</ProjectLayout>
