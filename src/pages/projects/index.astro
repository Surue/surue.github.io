---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentCard from "@/components/ContentCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
    .filter((entry) => !entry.data.draft)
    .sort(
        (left, right) =>
            (right.data.last_update?.getTime() ?? 0) -
            (left.data.last_update?.getTime() ?? 0),
    );

const projectGroups = [
    {
        key: "pro",
        title: "Professional projects",
        description:
            "Shipped production work, collaborations, and team-facing tool development.",
    },
    {
        key: "school",
        title: "School projects",
        description:
            "Longer technical experiments that shaped the engineering direction of the portfolio.",
    },
    {
        key: "jam",
        title: "Jam projects",
        description:
            "Short-cycle experiments where constraint, scope control, and fast iteration mattered most.",
    },
    {
        key: "perso",
        title: "Personal projects",
        description:
            "Independent explorations outside formal production contexts.",
    },
].map((group) => ({
    ...group,
    entries: projects.filter((project) => project.data.type === group.key),
}));

const highlightedProjects = projects.slice(0, 3);
---

<BaseLayout
    title="Projects"
    description="Selected games, tools, engine work, and technical experiments."
    eyebrow="Portfolio"
>
    <section class="editorial-split">
        <article class="hero-panel hero-copy hero-copy--feature">
            <p class="eyebrow">Project index</p>
            <h2 class="section-title">
                A portfolio that mixes shipped work, engine experiments, and
                production-facing tooling.
            </h2>
            <p class="lede">
                The useful split here is not only chronological. It is also
                contextual: professional production, school-scale technical
                projects, and jam work under heavy scope pressure.
            </p>
            <div class="hero-stats hero-stats--wide">
                <div class="metric metric--accent">
                    <strong
                        >{
                            projectGroups.find((group) => group.key === "pro")
                                ?.entries.length ?? 0
                        }</strong
                    >
                    <span>professional projects</span>
                </div>
                <div class="metric">
                    <strong
                        >{
                            projectGroups.find(
                                (group) => group.key === "school",
                            )?.entries.length ?? 0
                        }</strong
                    >
                    <span>school projects</span>
                </div>
                <div class="metric">
                    <strong
                        >{
                            projectGroups.find((group) => group.key === "jam")
                                ?.entries.length ?? 0
                        }</strong
                    >
                    <span>jam projects</span>
                </div>
            </div>
        </article>

        <aside class="split-panel split-panel--soft">
            <p class="eyebrow">Recent highlights</p>
            <div class="feature-list">
                {
                    highlightedProjects.map((project) => (
                        <a
                            class="feature-list__item"
                            href={`/projects/${project.slug}/`}
                        >
                            <strong>{project.data.title}</strong>
                            <span>
                                {project.data.role ??
                                    project.data.type ??
                                    "Project"}
                            </span>
                        </a>
                    ))
                }
            </div>
        </aside>
    </section>

    {
        projectGroups.map((group) => (
            <section class="group-stack">
                <div class="group-header">
                    <p class="eyebrow">{group.key}</p>
                    <h2 class="section-title">{group.title}</h2>
                    <p class="section-copy">{group.description}</p>
                </div>
                {group.entries.length > 0 ? (
                    <div class="content-grid">
                        {group.entries.map((project) => (
                            <ContentCard
                                eyebrow="Project"
                                entry={project}
                                href={`/projects/${project.slug}/`}
                            />
                        ))}
                    </div>
                ) : (
                    <div class="empty-state">
                        No Astro entries in this project group yet.
                    </div>
                )}
            </section>
        ))
    }
</BaseLayout>
