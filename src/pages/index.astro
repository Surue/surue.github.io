---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentCard from "@/components/ContentCard.astro";
import TagPill from "@/components/TagPill.astro";
import { featuredTopics, site, socialLinks } from "@/data/site";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("posts"))
  .filter((entry) => !entry.data.draft)
  .sort((left, right) => right.data.date.getTime() - left.data.date.getTime());

const featuredPosts = allPosts
  .filter((entry) => entry.data.featured)
  .slice(0, 3);

const latestPosts = (featuredPosts.length > 0 ? featuredPosts : allPosts).slice(
  0,
  3,
);

const allProjects = (await getCollection("projects"))
  .filter((entry) => !entry.data.draft)
  .sort(
    (left, right) =>
      (right.data.last_update?.getTime() ?? 0) -
      (left.data.last_update?.getTime() ?? 0),
  );

const featuredProjects = allProjects
  .filter((entry) => entry.data.featured)
  .slice(0, 3);

const latestProjects = (
  featuredProjects.length > 0 ? featuredProjects : allProjects
).slice(0, 3);

const latestPost = allPosts[0];
const coursePosts = allPosts.filter((entry) => entry.data.type === "course");
const devlogPosts = allPosts.filter(
  (entry) => entry.data.type === "devlog" || entry.data.type === "note",
);
const totalPosts = allPosts.length;
const totalProjects = allProjects.length;
const totalTags = new Set([
  ...allPosts.flatMap((entry) => entry.data.tags),
  ...allProjects.flatMap((entry) => entry.data.tags),
]).size;

const changelogEntries = [
  {
    title: "Add Bob2 as a project entry",
    version: "v2026.04.0f1",
    date: "2026-04-04",
  },
  {
    title: "Update Overall Layout",
    version: "v2026.03.1f1",
    date: "2026-03-27",
  },
  {
    title: "Transition from Jekyll to Astro",
    version: "v2026.03.0f1",
    date: "2026-03-27",
  },
];
---

<BaseLayout title={site.title} description={site.tagline}>
  <section class="hero hero--editorial">
    <div class="hero-panel hero-copy hero-copy--feature">
      <p class="eyebrow">Game dev knowledge base</p>
      <h1 class="display-title">
        Patch notes for code, tools, and production reality.
      </h1>
      <p class="lede lede--wide">
        Articles and courses now sit at the center of the site. The goal is
        simple: make technical reading durable, searchable, and pleasant enough
        to survive long sessions without eye fatigue.
      </p>
      <div class="chip-row">
        {featuredTopics.map((topic) => <span class="chip">{topic}</span>)}
      </div>
      <div class="cta-row">
        <a class="button" href="/projects/">Browse projects</a>
        <a class="button-secondary" href="/blog/">Read articles</a>
      </div>
      <div class="hero-stats hero-stats--wide">
        <div class="metric metric--accent">
          <strong>{totalPosts}</strong>
          <span>published editorial entries</span>
        </div>
        <div class="metric">
          <strong>{totalProjects}</strong>
          <span>projects documented with context</span>
        </div>
        <div class="metric">
          <strong>{totalTags}</strong>
          <span>topics to branch your reading path</span>
        </div>
      </div>
    </div>

    {
      latestPost ? (
        <aside class="hero-panel feature-panel">
          <p class="eyebrow">Now loading</p>
          {latestPost.data.thumbnail ? (
            <img
              class="feature-panel__image"
              src={latestPost.data.thumbnail}
              alt={latestPost.data.title}
            />
          ) : null}
          <h2>{latestPost.data.title}</h2>
          <p>{latestPost.data.description ?? latestPost.data.excerpt}</p>
          <div class="tag-row">
            {latestPost.data.tags.map((tag) => (
              <TagPill slug={tag} href={`/tags/${tag}/`} />
            ))}
          </div>
          <a class="button-secondary" href={`/blog/${latestPost.slug}/`}>
            Continue reading
          </a>
        </aside>
      ) : null
    }
  </section>

  <section class="terminal-banner card">
    <p class="eyebrow">Build output</p>
    <pre>{`$ npm run build
✓ articles loaded     : ${totalPosts}
✓ projects indexed    : ${totalProjects}
✓ topic hubs compiled : ${totalTags}
✓ status              : stable (no rage quit detected)`}</pre>
  </section>

  <section class="split-grid">
    <article class="split-panel split-panel--soft">
      <p class="eyebrow">Reader paths</p>
      <h2 class="section-title">
        Pick your run before diving into the archive
      </h2>
      <div class="path-grid">
        <article class="path-card card">
          <p class="eyebrow">Learning mode</p>
          <h3>Courses and structured write-ups</h3>
          <p class="path-card__meta">
            {coursePosts.length} entries marked as course format.
          </p>
          <a class="button-secondary" href="/blog/">Open course path</a>
        </article>
        <article class="path-card card">
          <p class="eyebrow">Quick updates</p>
          <h3>Devlogs and concise notes</h3>
          <p class="path-card__meta">
            {devlogPosts.length} entries optimized for fast reads.
          </p>
          <a class="button-secondary" href="/blog/">Open devlogs</a>
        </article>
        <article class="path-card card">
          <p class="eyebrow">Production context</p>
          <h3>Projects linked to real constraints</h3>
          <p class="path-card__meta">
            Browse implementation choices from shipped and prototype work.
          </p>
          <a class="button-secondary" href="/projects/">Open project index</a>
        </article>
      </div>
    </article>

    <article class="split-panel split-panel--accent">
      <p class="eyebrow">Patch notes</p>
      <h2 class="section-title">Current build highlights</h2>
      <ul class="changelog-list">
        {
          changelogEntries.map((entry) => (
            <li>
              <strong>{entry.title}</strong>
              <span class="changelog-meta">
                Updated · {entry.version} · {entry.date}
              </span>
            </li>
          ))
        }
      </ul>
    </article>
  </section>

  <section class="group-stack">
    <div class="group-header">
      <p class="eyebrow">Recent writing</p>
      <h2 class="section-title">Latest published entries</h2>
    </div>
    <div class="content-grid">
      {
        latestPosts.map((post) => (
          <ContentCard
            eyebrow={post.data.type === "course" ? "Course" : "Article"}
            entry={post}
            href={`/blog/${post.slug}/`}
          />
        ))
      }
    </div>
  </section>

  <section class="group-stack">
    <div class="group-header">
      <p class="eyebrow">Selected work</p>
      <h2 class="section-title">Projects across school and production</h2>
    </div>
    <div class="content-grid">
      {
        latestProjects.map((project) => (
          <ContentCard
            eyebrow="Project"
            entry={project}
            href={`/projects/${project.slug}/`}
          />
        ))
      }
    </div>
  </section>

  <section class="card card--contact">
    <p class="eyebrow">Contact</p>
    <h2 class="section-title">Primary links</h2>
    <div class="chip-row">
      {
        socialLinks.map((link) => (
          <a class="chip" href={link.href} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
